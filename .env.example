# ---------------------------------------------------------------
# Pflegewerk – Umgebungsvariablen (Beispiel)
# Kopiere diese Datei nach .env.local und passe die Werte an.
# Niemals echte Zugangsdaten committen.
# ---------------------------------------------------------------

# Anwendungs-Verbindung: Rolle OHNE Superuser/BYPASSRLS (Row-Level Security greift nur dann).
DATABASE_URL=postgres://pflegewerk_app:pflegewerk_app_dev@localhost:5434/pflegewerk
# Owner-Verbindung: nur für Migrationen und Wartungsskripte.
DATABASE_OWNER_URL=postgres://pflegewerk_owner:pflegewerk_owner_dev@localhost:5434/pflegewerk
# Name der Anwendungsrolle, der nach Migrationen Rechte erteilt werden.
DATABASE_APP_ROLE=pflegewerk_app

# Testdatenbank (wird von den Integrationstests bei jedem Lauf neu aufgebaut!)
TEST_DATABASE_URL=postgres://pflegewerk_app:pflegewerk_app_dev@localhost:5434/pflegewerk_test
TEST_DATABASE_OWNER_URL=postgres://pflegewerk_owner:pflegewerk_owner_dev@localhost:5434/pflegewerk_test

# Öffentliche Basis-URL (für Links in E-Mails)
APP_URL=http://localhost:3000

# Mindestens 32 zufällige Zeichen, z. B.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Zentrale Markenbezeichnung (Platzhalter, vor kommerzieller Nutzung Marken-/Domainprüfung durchführen)
NEXT_PUBLIC_BRAND_NAME=Pflegewerk

# E-Mail-Versand über SMTP. Ohne diese Werte werden KEINE E-Mails versendet;
# der Status wird als "nicht konfiguriert" protokolliert.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Schutz des Cron-Endpunkts (/api/cron). Mindestens 32 Zeichen.
CRON_SECRET=

# Aufbewahrungsfristen in Tagen. Die Werte sind Vorschläge und müssen vom
# Verantwortlichen festgelegt werden (siehe docs/DATENSCHUTZ.md).
AUDIT_RETENTION_DAYS=730
# Anfragen: ab letzter Bearbeitung
CONTACT_RETENTION_DAYS=365
# E-Mail-Versandprotokoll (Empfänger, Betreff, Status)
EMAIL_LOG_RETENTION_DAYS=90
# In-App-Benachrichtigungen
NOTIFICATION_RETENTION_DAYS=365
# Erledigte Einladungen (angenommen, widerrufen, abgelaufen)
INVITATION_RETENTION_DAYS=30

# Nur hinter einem vertrauenswürdigen Proxy auf "true" setzen (wertet X-Forwarded-For aus)
TRUST_PROXY=false
